# Kopiere nach .env bzw. setze die Variablen in deiner Umgebung
PORT=8787
HOST=127.0.0.1
# Passwortschutz (empfohlen, sobald die App im Netz erreichbar ist)
APP_PASSWORD=
# Öffentliche URL, damit Anbieter Eingabedateien per URL laden können (z. B. Luma)
PUBLIC_URL=
# Eigenes Geheimnis für die Verschlüsselung der API-Schlüssel
MUSII_SECRET=
# Speicherort für Datenbank und Medien
MUSII_DATA_DIR=./data
